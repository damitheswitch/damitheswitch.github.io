---
import { site } from '../data/resume';
---

<section id="contact" class="contact">
  <div class="container center reveal">
    <p class="section-label centered">06 · contact</p>
    <h2 class="big">Let's build something<br />intelligent<span class="accent">.</span></h2>
    <p class="sub">
      I'm open to research collaborations, internships, freelance work, or just a good conversation
      about AI agents and computer vision.
    </p>
    <div class="cta-row">
      <div class="hello-wrap">
        <button
          id="hello-btn"
          class="btn primary"
          aria-expanded="false"
          aria-haspopup="menu"
          aria-controls="hello-pop"
        >
          say hello →
        </button>
        <div class="hello-pop" id="hello-pop" role="menu" aria-label="Contact channels">
          <p class="pop-label">$ pick a channel</p>
          <div class="pop-item pop-row" role="group" aria-label="Email options">
            <span class="k">email</span>
            <span class="acts">
              <a role="menuitem" href={`mailto:${site.email}`} class="act" aria-label="Open mail app" title="open mail app">↗</a>
              <button role="menuitem" id="copy-email" class="act" aria-label="Copy email address" title="copy" type="button">
                <span id="copy-label">⧉</span>
              </button>
            </span>
          </div>
          <a role="menuitem" href={site.socials.linkedin} target="_blank" rel="noopener" class="pop-item">
            <span class="k">linkedin</span><span class="v">↗</span>
          </a>
          <a role="menuitem" href={site.socials.x} target="_blank" rel="noopener" class="pop-item">
            <span class="k">x</span><span class="v">↗</span>
          </a>
          <a role="menuitem" href={site.socials.github} target="_blank" rel="noopener" class="pop-item">
            <span class="k">github</span><span class="v">↗</span>
          </a>
        </div>
      </div>
      <a href="/Imad_Charradi.vcf" class="btn ghost">save contact ↓</a>
    </div>
  </div>
</section>

<footer>
  <div class="container foot">
    <div class="socials">
      <a href={site.socials.github} target="_blank" rel="noopener" aria-label="GitHub">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"></path>
        </svg>
      </a>
      <a href={site.socials.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"></path>
        </svg>
      </a>
      <a href={site.socials.x} target="_blank" rel="noopener" aria-label="X / Twitter">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
        </svg>
      </a>
      <a href={`mailto:${site.email}`} aria-label="Email">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-10 5L2 7"></path>
        </svg>
      </a>
    </div>
    <p class="credit">designed &amp; built by imad charradi · <span>astro + github pages</span></p>
  </div>
</footer>

<style>
  .contact {
    text-align: center;
    padding-bottom: 120px;
  }

  .centered {
    justify-content: center;
  }

  .centered::before {
    display: none;
  }

  .big {
    font-size: clamp(2rem, 5.5vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-top: 14px;
  }

  .accent {
    color: var(--accent);
  }

  .sub {
    max-width: 480px;
    margin: 24px auto 0;
    color: var(--text-dim);
  }

  .cta-row {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 40px;
  }

  .btn {
    font-family: var(--mono);
    font-size: 0.9rem;
    padding: 14px 30px;
    border-radius: 8px;
    display: inline-block;
    transition:
      transform 0.2s,
      box-shadow 0.2s,
      border-color 0.2s,
      color 0.2s;
  }

  .btn.primary {
    background: var(--accent);
    color: #06281c;
    font-weight: 600;
  }

  .btn.primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(52, 211, 153, 0.3);
  }

  .btn.ghost {
    border: 1px solid var(--border-hover);
    color: var(--text-dim);
  }

  .btn.ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
  }

  .hello-wrap {
    position: relative;
  }

  .hello-pop {
    position: absolute;
    bottom: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    min-width: 230px;
    background: var(--bg-elev);
    border: 1px solid var(--border-hover);
    border-radius: 10px;
    padding: 8px;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.5);
    font-family: var(--mono);
    font-size: 0.82rem;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      visibility 0.18s;
    z-index: 50;
  }

  .hello-wrap.open .hello-pop {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .pop-label {
    color: var(--accent);
    font-size: 0.72rem;
    padding: 6px 10px 8px;
  }

  .pop-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
    width: 100%;
    padding: 9px 10px;
    border-radius: 6px;
    background: none;
    border: none;
    color: var(--text-dim);
    font-family: inherit;
    font-size: inherit;
    cursor: pointer;
    text-align: left;
    transition:
      background 0.15s,
      color 0.15s;
  }

  .pop-item:hover,
  .pop-item:focus-visible {
    background: var(--accent-dim);
    color: var(--accent);
    outline: none;
  }

  .pop-item .k {
    color: var(--text);
  }

  .pop-item:hover .k,
  .pop-item:focus-visible .k {
    color: var(--accent);
  }

  .pop-item .v {
    color: var(--text-faint);
    font-size: 0.75rem;
  }

  .pop-item:hover .v,
  .pop-item:focus-visible .v {
    color: var(--accent);
  }

  .pop-row:hover,
  .pop-row:focus-visible {
    background: none;
    color: inherit;
  }

  .pop-row:hover .k {
    color: var(--text);
  }

  .acts {
    display: inline-flex;
    gap: 6px;
  }

  .act {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 26px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-card);
    color: var(--text-faint);
    font-family: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    transition:
      border-color 0.15s,
      color 0.15s,
      background 0.15s;
  }

  .act:hover,
  .act:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-dim);
    outline: none;
  }

  footer {
    border-top: 1px solid var(--border);
    padding: 36px 0;
  }

  .foot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  .socials {
    display: flex;
    gap: 22px;
  }

  .socials a {
    color: var(--text-faint);
    transition:
      color 0.2s,
      transform 0.2s;
    display: inline-flex;
  }

  .socials a:hover {
    color: var(--accent);
    transform: translateY(-2px);
  }

  .credit {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  .credit span {
    color: var(--text-dim);
  }
</style>

<script define:vars={{ email: site.email }}>
  const wrap = document.querySelector('.hello-wrap');
  const btn = document.getElementById('hello-btn');
  const pop = document.getElementById('hello-pop');
  const copyBtn = document.getElementById('copy-email');
  const copyLabel = document.getElementById('copy-label');

  const setOpen = (open) => {
    wrap?.classList.toggle('open', open);
    btn?.setAttribute('aria-expanded', String(open));
    if (open) pop?.querySelector('a, button')?.focus();
  };

  btn?.addEventListener('click', (e) => {
    e.stopPropagation();
    setOpen(!wrap?.classList.contains('open'));
  });

  document.addEventListener('click', (e) => {
    if (wrap && !wrap.contains(e.target)) setOpen(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });

  pop?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => setOpen(false)),
  );

  copyBtn?.addEventListener('click', async (e) => {
    e.stopPropagation();
    try {
      await navigator.clipboard.writeText(email);
      if (copyLabel) {
        copyLabel.textContent = '✓';
        copyLabel.style.color = 'var(--accent)';
        setTimeout(() => {
          copyLabel.textContent = '⧉';
          copyLabel.style.color = '';
        }, 1600);
      }
    } catch {
      window.location.href = 'mailto:' + email;
    }
  });
</script>
