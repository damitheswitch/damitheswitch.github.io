          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 3v18M19 4.5 6.2 12.3M10.5 9.5 19 20"></path>
          </svg>
        </a>
        <a href={site.socials.huggingface} target="_blank" rel="noopener" aria-label="Hugging Face">
