---
import { site, rotatorPhrases } from '../data/resume';
---

<section class="hero" id="top">
  <div class="container hero-grid">
    <div class="hero-text">
      <p class="greeting">$ whoami</p>
      <h1>
        Imad Charradi<span class="accent">.</span>
      </h1>
      <h2 class="role">{site.role}</h2>
      <p class="tagline">
        <span class="sr-only">{site.tagline}</span>
        <span aria-hidden="true">
          <span class="i">I</span>
          <span id="typed"></span><span class="type-caret"></span>
        </span>
      </p>

      <div class="meta">
        <span class="meta-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle>
          </svg>
          {site.location}
        </span>
        <span class="meta-item status">
          <span class="dot"></span> open to opportunities
        </span>
      </div>

      <div class="ctas">
        <a href="#projects" class="btn primary">view projects</a>
        <a href={site.cvUrl} class="btn ghost" target="_blank" rel="noopener">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          resume.pdf
        </a>
      </div>

      <div class="socials">
        <a href={site.socials.github} target="_blank" rel="noopener" aria-label="GitHub">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"></path>
          </svg>
        </a>
        <a href={site.socials.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"></path>
          </svg>
        </a>
        <a href={site.socials.x} target="_blank" rel="noopener" aria-label="X / Twitter">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
          </svg>
        </a>
        <a href={`mailto:${site.email}`} aria-label="Email">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-10 5L2 7"></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="terminal reveal">
      <div class="term-bar">
        <span class="term-dot r"></span><span class="term-dot y"></span><span class="term-dot g"></span>
        <span class="term-title">imad@dev ~ zsh</span>
      </div>
      <div class="term-body">
        <p><span class="p">$</span> whoami</p>
        <p class="out">imad-charradi</p>
        <p><span class="p">$</span> cat focus.txt</p>
        <p class="out">ai-agents · computer-vision · backends</p>
        <p><span class="p">$</span> ./current_status</p>
        <p class="out">m.sc. ai @ xidian · <span class="ok">building trc</span></p>
        <p><span class="p">$</span> langs --spoken</p>
        <p class="out">ar · en · fr · zh · es</p>
        <p><span class="p">$</span> <span class="caret"></span></p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 110px;
    padding-bottom: 60px;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 45% at 75% 20%, rgba(52, 211, 153, 0.07), transparent),
      radial-gradient(ellipse 50% 40% at 15% 85%, rgba(52, 211, 153, 0.04), transparent);
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 60px;
    align-items: center;
    position: relative;
  }

  .greeting {
    font-family: var(--mono);
    color: var(--accent);
    font-size: 0.95rem;
    margin-bottom: 18px;
  }

  h1 {
    font-size: clamp(2.6rem, 6.5vw, 4.4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .accent {
    color: var(--accent);
  }

  .role {
    font-size: clamp(1.2rem, 3vw, 1.7rem);
    font-weight: 600;
    color: var(--text-dim);
    margin-top: 10px;
  }

  .tagline {
    margin-top: 22px;
    max-width: 520px;
    font-family: var(--mono);
    font-size: 1rem;
    color: var(--text);
    min-height: 1.65em;
  }

  .tagline .i {
    color: var(--accent);
    font-weight: 600;
    margin-right: 2px;
  }

  .type-caret {
    display: inline-block;
    width: 8px;
    height: 1.05em;
    margin-left: 3px;
    background: var(--accent);
    vertical-align: text-bottom;
    animation: blink 1.1s step-end infinite;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 22px;
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--text-faint);
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .status .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    50% {
      opacity: 0.4;
    }
  }

  .ctas {
    display: flex;
    gap: 14px;
    margin-top: 34px;
    flex-wrap: wrap;
  }

  .btn {
    font-family: var(--mono);
    font-size: 0.85rem;
    padding: 12px 22px;
    border-radius: 7px;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    transition:
      transform 0.2s,
      background 0.2s,
      box-shadow 0.2s;
  }

  .btn.primary {
    background: var(--accent);
    color: #06281c;
    font-weight: 600;
  }

  .btn.primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(52, 211, 153, 0.25);
  }

  .btn.ghost {
    border: 1px solid var(--border-hover);
    color: var(--text-dim);
  }

  .btn.ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
  }

  .socials {
    display: flex;
    gap: 22px;
    margin-top: 38px;
  }

  .socials a {
    color: var(--text-faint);
    transition:
      color 0.2s,
      transform 0.2s;
    display: inline-flex;
  }

  .socials a:hover {
    color: var(--accent);
    transform: translateY(-3px);
  }

  .terminal {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
    font-family: var(--mono);
    font-size: 0.82rem;
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px 16px;
    background: var(--bg-elev);
    border-bottom: 1px solid var(--border);
  }

  .term-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }
  .term-dot.r {
    background: #ff5f57;
  }
  .term-dot.y {
    background: #febc2e;
  }
  .term-dot.g {
    background: #28c840;
  }

  .term-title {
    margin-left: 10px;
    color: var(--text-faint);
    font-size: 0.75rem;
  }

  .term-body {
    padding: 20px 18px 24px;
    line-height: 2;
  }

  .term-body .p {
    color: var(--accent);
  }

  .term-body .out {
    color: var(--text-dim);
    padding-left: 14px;
  }

  .term-body .ok {
    color: var(--accent);
  }

  .caret {
    display: inline-block;
    width: 8px;
    height: 15px;
    background: var(--accent);
    vertical-align: middle;
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    .hero {
      min-height: auto;
    }
  }
</style>

<script define:vars={{ phrases: rotatorPhrases }}>
  const el = document.getElementById('typed');
  if (el) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.textContent = phrases[0];
    } else {
      let pi = 0;
      let ci = 0;
      let deleting = false;
      const tick = () => {
        const phrase = phrases[pi];
        if (!deleting) {
          ci++;
          el.textContent = phrase.slice(0, ci);
          if (ci === phrase.length) {
            deleting = true;
            setTimeout(tick, 2000);
            return;
          }
          setTimeout(tick, 55);
        } else {
          ci--;
          el.textContent = phrase.slice(0, ci);
          if (ci === 0) {
            deleting = false;
            pi = (pi + 1) % phrases.length;
            setTimeout(tick, 400);
            return;
          }
          setTimeout(tick, 28);
        }
      };
      setTimeout(tick, 700);
    }
  }
</script>
