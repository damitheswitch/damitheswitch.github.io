          </svg>
        </a>
        <a href={site.socials.x} target="_blank" rel="noopener" aria-label="X / Twitter">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
          </svg>
        </a>
        <a href={`mailto:${site.email}`} aria-label="Email">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-10 5L2 7"></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="terminal reveal">
      <div class="term-bar">
        <span class="term-dot r"></span><span class="term-dot y"></span><span class="term-dot g"></span>
        <span class="term-title">imad@dev ~ zsh</span>
      </div>
      <div class="term-body">
        <p><span class="p">$</span> whoami</p>
        <p class="out">imad-charradi</p>
        <p><span class="p">$</span> cat focus.txt</p>
        <p class="out">ai-agents · bio/brain-inspired · backends</p>
        <p><span class="p">$</span> ./current_status</p>
        <p class="out">m.sc. ai @ xidian · <span class="ok">building trc</span></p>
        <p><span class="p">$</span> langs --spoken</p>
        <p class="out">ar · en · fr · zh · es</p>
        <p><span class="p">$</span> <span class="caret"></span></p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 110px;
    padding-bottom: 60px;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 45% at 75% 20%, rgba(52, 211, 153, 0.07), transparent),
      radial-gradient(ellipse 50% 40% at 15% 85%, rgba(52, 211, 153, 0.04), transparent);
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 60px;
    align-items: center;
    position: relative;
  }

  .greeting {
    font-family: var(--mono);
    color: var(--accent);
    font-size: 0.95rem;
    margin-bottom: 18px;
  }

  h1 {
    font-size: clamp(2.6rem, 6.5vw, 4.4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .accent {
    color: var(--accent);
  }

  .role {
    font-size: clamp(1.2rem, 3vw, 1.7rem);
    font-weight: 600;
    color: var(--text-dim);
    margin-top: 10px;
  }

  .tagline {
    margin-top: 22px;
    max-width: 520px;
    font-family: var(--mono);
    font-size: 1rem;
    color: var(--text);
    min-height: 1.65em;
  }

  .tagline .i {
    color: var(--accent);
    font-weight: 600;
    margin-right: 0.4em;
  }

  .type-caret {
    display: inline-block;
    width: 8px;
    height: 1.05em;
    margin-left: 3px;
    background: var(--accent);
    vertical-align: text-bottom;
    animation: blink 1.1s step-end infinite;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 22px;
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--text-faint);
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .status .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    50% {
      opacity: 0.4;
    }
  }

  .ctas {
    display: flex;
    gap: 14px;
    margin-top: 34px;
    flex-wrap: wrap;
  }

  .btn {
    font-family: var(--mono);
    font-size: 0.85rem;
    padding: 12px 22px;
    border-radius: 7px;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    transition:
      transform 0.2s,
      background 0.2s,
      box-shadow 0.2s;
  }

  .btn.primary {
    background: var(--accent);
    color: #06281c;
    font-weight: 600;
  }

  .btn.primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(52, 211, 153, 0.25);
  }

  .btn.ghost {
    border: 1px solid var(--border-hover);
    color: var(--text-dim);
  }

  .btn.ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
  }

  .socials {
    display: flex;
    gap: 22px;
    margin-top: 38px;
  }

  .socials a {
    color: var(--text-faint);
    transition:
      color 0.2s,
      transform 0.2s;
    display: inline-flex;
  }

  .socials a:hover {
    color: var(--accent);
    transform: translateY(-3px);
  }

  .terminal {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
    font-family: var(--mono);
    font-size: 0.82rem;
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px 16px;
    background: var(--bg-elev);
    border-bottom: 1px solid var(--border);
  }

  .term-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }
  .term-dot.r {
    background: #ff5f57;
  }
  .term-dot.y {
    background: #febc2e;
  }
  .term-dot.g {
    background: #28c840;
  }

  .term-title {
    margin-left: 10px;
    color: var(--text-faint);
    font-size: 0.75rem;
  }

  .term-body {
    padding: 20px 18px 24px;
    line-height: 2;
  }

  .term-body .p {
    color: var(--accent);
  }

  .term-body .out {
    color: var(--text-dim);
    padding-left: 14px;
  }

  .term-body .ok {
    color: var(--accent);
  }

  .caret {
    display: inline-block;
    width: 8px;
    height: 15px;
    background: var(--accent);
    vertical-align: middle;
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    .hero {
      min-height: auto;
    }
  }
</style>

<script define:vars={{ phrases: rotatorPhrases }}>
  const el = document.getElementById('typed');
  if (el) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.textContent = phrases[0];
    } else {
      let pi = 0;
      let ci = 0;
      let deleting = false;
      const holds = [1400, 2200, 1600, 2200, 2400, 1600];
      const tick = () => {
        const phrase = phrases[pi];
        if (!deleting) {
          ci++;
          el.textContent = phrase.slice(0, ci);
          if (ci === phrase.length) {
            deleting = true;
            setTimeout(tick, holds[pi]);
            return;
          }
          setTimeout(tick, 55);
        } else {
          ci--;
          el.textContent = phrase.slice(0, ci);
          if (ci === 0) {
            deleting = false;
            pi = (pi + 1) % phrases.length;
            setTimeout(tick, 400);
            return;
          }
          setTimeout(tick, 28);
        }
      };
      setTimeout(tick, 700);
    }
  }
</script>
