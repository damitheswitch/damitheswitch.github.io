---
import { experience } from '../data/resume';
---

<section id="experience">
  <div class="container">
    <p class="section-label">02 · experience</p>
    <h2 class="section-title">Where I've worked</h2>

    <div class="timeline">
      {
        experience.map((job) => (
          <article class="job reveal">
            <div class="job-head">
              <div>
                <h3>{job.role}</h3>
                <p class="org">
                  {job.org} <span class="loc">· {job.location}</span>
                </p>
              </div>
              <span class="period">{job.period}</span>
            </div>
            <ul>
              {job.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    padding-left: 28px;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: var(--border);
  }

  .job {
    position: relative;
    margin-bottom: 44px;
  }

  .job:last-child {
    margin-bottom: 0;
  }

  .job::before {
    content: '';
    position: absolute;
    left: -32px;
    top: 8px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }

  .job-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 18px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .job h3 {
    font-size: 1.12rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .org {
    color: var(--text-dim);
    font-size: 0.95rem;
    margin-top: 3px;
  }

  .loc {
    color: var(--text-faint);
  }

  .period {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--accent);
    background: var(--accent-dim);
    padding: 5px 12px;
    border-radius: 20px;
    white-space: nowrap;
  }

  .job ul {
    list-style: none;
  }

  .job li {
    color: var(--text-dim);
    font-size: 0.95rem;
    padding: 5px 0 5px 24px;
    position: relative;
  }

  .job li::before {
    content: '▹';
    position: absolute;
    left: 0;
    color: var(--accent);
  }
</style>
