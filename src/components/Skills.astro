---
import { skillGroups } from '../data/resume';
---

<section id="skills">
  <div class="container">
    <p class="section-label">04 · skills</p>
    <h2 class="section-title">My toolbox</h2>

    <div class="groups">
      {
        skillGroups.map((g) => (
          <div class="group reveal">
            <h3>{g.label}</h3>
            <ul>
              {g.items.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
    gap: 22px;
  }

  .group {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px 26px;
    transition: border-color 0.25s;
  }

  .group:hover {
    border-color: var(--border-hover);
  }

  .group h3 {
    font-family: var(--mono);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--accent);
    margin-bottom: 16px;
  }

  .group ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
  }

  .group li {
    font-size: 0.82rem;
    color: var(--text-dim);
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 7px;
    padding: 5px 11px;
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .group li:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
