---
const sections = [
  { id: 'top', num: '~', label: 'top' },
  { id: 'about', num: '01', label: 'about' },
  { id: 'experience', num: '02', label: 'experience' },
  { id: 'projects', num: '03', label: 'projects' },
  { id: 'skills', num: '04', label: 'skills' },
  { id: 'education', num: '05', label: 'education' },
  { id: 'contact', num: '06', label: 'contact' },
];
---

<div class="rail" id="scroll-rail">
  <div class="rail-body" id="rail-body">
    <span class="rail-track"></span>
    <span class="rail-fill" id="rail-fill"></span>
    {
      sections.map((s) => (
        <button
          class="rail-tick"
          type="button"
          data-target={s.id}
          data-label={`${s.num} · ${s.label}`}
          aria-label={`jump to ${s.label}`}
          tabindex="-1"
        >
          <span class="tick-tag">
            {s.num} · {s.label}
          </span>
        </button>
      ))
    }
    <button
      class="rail-thumb"
      id="rail-thumb"
      type="button"
      role="slider"
      aria-label="scroll position"
      aria-orientation="vertical"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      aria-valuetext="top"></button>
    <span class="rail-cur" id="rail-cur"></span>
  </div>
</div>

<style>
  .rail {
    position: fixed;
    right: 22px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 90;
    height: min(360px, 46vh);
    font-family: var(--mono);
    user-select: none;
    -webkit-user-select: none;
  }

  .rail-body {
    position: relative;
    height: 100%;
    width: 30px;
    touch-action: none;
    cursor: pointer;
  }

  .rail-track {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    transform: translateX(-50%);
    background: var(--border);
    border-radius: 1px;
    transition: background 0.2s;
  }

  .rail:hover .rail-track {
    background: var(--border-hover);
  }

  .rail-fill {
    position: absolute;
    left: 50%;
    top: 0;
    width: 2px;
    height: 0;
    transform: translateX(-50%);
    background: var(--accent);
    border-radius: 1px;
    opacity: 0.35;
    pointer-events: none;
  }

  .rail-tick {
    position: absolute;
    left: 50%;
    width: 9px;
    height: 2px;
    padding: 0;
    border: 0;
    border-radius: 1px;
    background: var(--text-faint);
    opacity: 0.5;
    transform: translate(-50%, -50%);
    cursor: pointer;
    transition:
      opacity 0.2s,
      width 0.2s,
      background 0.2s;
  }

  .rail-tick::before {
    content: '';
    position: absolute;
    inset: -9px -11px;
  }

  .rail-tick.done {
    background: var(--accent);
    opacity: 0.45;
  }

  .rail-tick.active {
    background: var(--accent);
    opacity: 1;
    width: 13px;
  }

  .rail-tick:hover {
    opacity: 1;
    background: var(--accent);
  }

  .tick-tag {
    position: absolute;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.68rem;
    color: var(--text-dim);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.15s;
    pointer-events: none;
  }

  .rail-tick:hover .tick-tag,
  .rail-tick:focus-visible .tick-tag {
    opacity: 1;
  }

  .rail-thumb {
    position: absolute;
    left: 50%;
    top: 0;
    width: 4px;
    height: 26px;
    padding: 0;
    border: 0;
    border-radius: 2px;
    background: var(--accent);
    transform: translate(-50%, -50%);
    cursor: grab;
    box-shadow: 0 0 10px rgba(52, 211, 153, 0.3);
    transition:
      height 0.15s,
      box-shadow 0.15s;
    touch-action: none;
  }

  .rail-thumb::before {
    content: '';
    position: absolute;
    inset: -11px -14px;
  }

  .rail-thumb:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 4px;
  }

  .rail-thumb.dragging {
    cursor: grabbing;
    height: 36px;
    box-shadow: 0 0 18px rgba(52, 211, 153, 0.55);
  }

  .rail-cur {
    position: absolute;
    right: calc(100% + 12px);
    top: 0;
    transform: translateY(-50%);
    font-size: 0.7rem;
    color: var(--accent);
    letter-spacing: 0.04em;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.18s;
    pointer-events: none;
  }

  .rail-cur.ping,
  .rail.dragging .rail-cur,
  .rail-body:hover .rail-cur {
    opacity: 1;
  }

  @media (max-width: 820px) {
    .rail {
      right: max(6px, env(safe-area-inset-right));
      height: min(280px, 38vh);
    }

    .rail-body {
      width: 26px;
    }

    .tick-tag {
      display: none;
    }

    .rail-cur {
      right: calc(100% + 8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail-track,
    .rail-tick,
    .tick-tag,
    .rail-thumb,
    .rail-cur {
      transition: none;
    }
  }
</style>

<script>
  const rail = document.getElementById('scroll-rail');
  const body = document.getElementById('rail-body');
  const fill = document.getElementById('rail-fill');
  const thumb = document.getElementById('rail-thumb');
  const cur = document.getElementById('rail-cur');
  const rootEl = document.documentElement;

  if (rail && body && fill && thumb && cur) {
    const ticks = Array.from(rail.querySelectorAll('.rail-tick'));
    const targets = ticks.map((t) => document.getElementById(t.dataset.target));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let maxScroll = 1;
    let tops = [];
    let idx = -1;
    let dragging = false;
    let interactingUntil = 0;
    let pingT;

    // synthesized sfx, no audio assets. stays silent until the first pointer gesture unlocks the context
    let actx = null;
    function ac() {
      const AC = window.AudioContext || window.webkitAudioContext;
      if (!AC) return null;
      if (!actx) actx = new AC();
      if (actx.state === 'suspended') actx.resume();
      return actx;
    }
    function tone(freq, dur, gain) {
      const a = ac();
      if (!a) return;
      const o = a.createOscillator();
      const g = a.createGain();
      o.type = 'sine';
      o.frequency.value = freq;
      g.gain.setValueAtTime(gain, a.currentTime);
      g.gain.exponentialRampToValueAtTime(0.0001, a.currentTime + dur);
      o.connect(g).connect(a.destination);
      o.start();
      o.stop(a.currentTime + dur + 0.02);
    }
    function tickSfx() {
      const a = ac();
      if (!a) return;
      const n = Math.floor(a.sampleRate * 0.025);
      const buf = a.createBuffer(1, n, a.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < n; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / n);
      const src = a.createBufferSource();
      src.buffer = buf;
      const f = a.createBiquadFilter();
      f.type = 'bandpass';
      f.frequency.value = 3400;
      f.Q.value = 1.2;
      const g = a.createGain();
      g.gain.setValueAtTime(0.055, a.currentTime);
      g.gain.exponentialRampToValueAtTime(0.0001, a.currentTime + 0.025);
      src.connect(f).connect(g).connect(a.destination);
      src.start();
    }
    const buzz = (ms) => navigator.vibrate?.(ms);
    const interacting = () => dragging || performance.now() < interactingUntil;

    function measure() {
      maxScroll = Math.max(1, rootEl.scrollHeight - window.innerHeight);
      tops = targets.map((el) => (el ? el.getBoundingClientRect().top + window.scrollY : 0));
      ticks.forEach((t, i) => {
        t.style.top = `${Math.min(1, tops[i] / maxScroll) * 100}%`;
      });
      rail.style.display = rootEl.scrollHeight < window.innerHeight * 1.4 ? 'none' : '';
      update();
    }

    function currentIndex() {
      const probe = window.scrollY + window.innerHeight * 0.3;
      let i = 0;
      for (let k = 0; k < tops.length; k++) if (tops[k] <= probe) i = k;
      if (window.scrollY >= maxScroll - 4) i = tops.length - 1;
      return i;
    }

    function setIdx(i) {
      if (i === idx) return;
      idx = i;
      ticks.forEach((t, k) => {
        t.classList.toggle('active', k === i);
        t.classList.toggle('done', k < i);
      });
      const label = ticks[i]?.dataset.label || '';
      cur.textContent = label;
      thumb.setAttribute('aria-valuetext', label);
      cur.classList.add('ping');
      clearTimeout(pingT);
      pingT = setTimeout(() => cur.classList.remove('ping'), 1400);
      if (interacting()) {
        tickSfx();
        buzz(8);
      }
    }

    let raf = false;
    function update() {
      const frac = Math.min(1, Math.max(0, window.scrollY / maxScroll));
      const y = frac * body.getBoundingClientRect().height;
      thumb.style.top = `${y}px`;
      fill.style.height = `${y}px`;
      cur.style.top = `${y}px`;
      thumb.setAttribute('aria-valuenow', String(Math.round(frac * 100)));
      setIdx(currentIndex());
    }
    window.addEventListener(
      'scroll',
      () => {
        if (!raf) {
          raf = true;
          requestAnimationFrame(() => {
            raf = false;
            update();
          });
        }
      },
      { passive: true },
    );

    function railFrac(clientY) {
      const r = body.getBoundingClientRect();
      return Math.min(1, Math.max(0, (clientY - r.top) / r.height));
    }

    function jumpTo(i) {
      const top = i === 0 ? 0 : Math.min(tops[i] - 76, maxScroll);
      interactingUntil = performance.now() + 900;
      tickSfx();
      buzz(6);
      window.scrollTo({ top: Math.max(0, top), behavior: reduced ? 'auto' : 'smooth' });
    }

    function moveDrag(e) {
      window.scrollTo(0, railFrac(e.clientY) * maxScroll);
    }

    thumb.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      dragging = true;
      rail.classList.add('dragging');
      thumb.classList.add('dragging');
      try {
        thumb.setPointerCapture(e.pointerId);
      } catch {}
      rootEl.style.scrollBehavior = 'auto';
      ac();
      tone(520, 0.05, 0.03);
      buzz(10);
      moveDrag(e);
    });
    thumb.addEventListener('pointermove', (e) => {
      if (dragging) moveDrag(e);
    });
    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      rail.classList.remove('dragging');
      thumb.classList.remove('dragging');
      rootEl.style.scrollBehavior = '';
      interactingUntil = performance.now() + 600;
      tone(330, 0.07, 0.035);
    };
    thumb.addEventListener('pointerup', endDrag);
    thumb.addEventListener('pointercancel', endDrag);

    body.addEventListener('pointerdown', (e) => {
      if (e.target.closest('.rail-thumb') || e.target.closest('.rail-tick')) return;
      ac();
      interactingUntil = performance.now() + 900;
      tickSfx();
      window.scrollTo({
        top: railFrac(e.clientY) * maxScroll,
        behavior: reduced ? 'auto' : 'smooth',
      });
    });

    ticks.forEach((t, i) => t.addEventListener('click', () => jumpTo(i)));

    thumb.addEventListener('keydown', (e) => {
      const last = ticks.length - 1;
      let handled = true;
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight' || e.key === 'PageDown')
        jumpTo(Math.min(idx + 1, last));
      else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft' || e.key === 'PageUp')
        jumpTo(Math.max(idx - 1, 0));
      else if (e.key === 'Home') jumpTo(0);
      else if (e.key === 'End') jumpTo(last);
      else handled = false;
      if (handled) e.preventDefault();
    });

    measure();
    window.addEventListener('resize', measure);
    window.addEventListener('load', measure);
    document.fonts?.ready.then(measure);
  }
</script>
